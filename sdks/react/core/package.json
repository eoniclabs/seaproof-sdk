{
  "name": "@seaproof/core",
  "version": "0.1.0-beta.1",
  "description": "Seaproof client for any web app: send bug reports, feedback and ideas with screenshots, diagnostics and screen recordings.",
  "license": "MIT",
  "homepage": "https://seaproof.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eoniclabs/seaproof-sdk.git",
    "directory": "sdks/react/core"
  },
  "bugs": "https://github.com/eoniclabs/seaproof-sdk/issues",
  "keywords": [
    "feedback",
    "bug-report",
    "screenshot",
    "beta-testing",
    "seaproof"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../copy-package-docs.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "html-to-image": "^1.11.13"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
